# Copy this file to .env and fill in the values.
# .env is gitignored — never commit secrets.

# ── Inference ──────────────────────────────────────────────────────────────────
# Path to a local directory OR a Hugging Face repo id (e.g. YourUser/car-damage-model)
SEG_MODEL_PATH=models/car_damage_segmentation

# Path to YOLO weights for car-parts segmentation (optional)
YOLO_MODEL_PATH=best.pt

# Input image size expected by the segmentation model
IMAGE_SIZE=512

# ── API server ─────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
# Set to "true" to enable hot-reload during development
RELOAD=false
# Comma-separated list of allowed CORS origins (use * to allow all)
CORS_ORIGINS=*

# ── Hugging Face ───────────────────────────────────────────────────────────────
HF_TOKEN=
HF_REPO_ID=YourUser/car-damage-model
